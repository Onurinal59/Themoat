# Required by the Vercel AI Coach API routes.
# Create a Workers AI token in the Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_WORKERS_AI_API_TOKEN"

# Optional: only used by the legacy local Express server.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional application URL for local integrations.
APP_URL="YOUR_APP_URL"
